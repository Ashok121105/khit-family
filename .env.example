NODE_ENV=development
PORT=5000
HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5000
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-long-admin-password

# OTP / MFA / security
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_ISSUER=KHIT Family Portal

# Database and runtime
DATABASE_URL=
PGSSL=false
DB_POOL_MIN=1
DB_POOL_MAX=10

# Email / messaging
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_RESET_EMAIL=
SMS_API_KEY=
SMS_SENDER_ID=

# Storage configuration
UPLOAD_STORAGE=local
UPLOAD_PATH=./uploads
UPLOAD_MAX_FILE_SIZE_MB=10
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# External API keys
API_KEY_INTERNAL=
API_KEY_REPORTING=